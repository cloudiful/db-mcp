{
  "server": {
    "name": "db-mcp",
    "version": "0.1.0",
    "transport": "stdio",
    "httpAddr": "0.0.0.0:8080",
    "httpPath": "/mcp"
  },
  "limits": {
    "defaultMaxRows": 5,
    "hardMaxRows": 20,
    "maxColumns": 40,
    "maxCellChars": 512,
    "maxTotalChars": 1000,
    "explainMaxLines": 12,
    "explainMaxTotalChars": 4000,
    "queryTimeout": "15s"
  },
  "connections": [
    {
      "name": "oracle-dev",
      "driver": "oracle",
      "oracle": {
        "jdbcUrl": "jdbc:oracle:thin:@localhost:1521:XE",
        "username": "readuser",
        "password": "readuser"
      }
    },
    {
      "name": "postgres-dev",
      "driver": "postgres",
      "postgres": {
        "dsn": "postgres://reader:reader@localhost:5432/app?sslmode=disable"
      }
    },
    {
      "name": "sqlite-dev",
      "driver": "sqlite",
      "sqlite": {
        "dsn": "file:./app.db?mode=ro"
      }
    }
  ]
}
